generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  googleId     String?  @unique
  email        String   @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  // Relations
  workspaceRoles WorkspaceMember[]
  reportedIssues Issue[]           @relation("IssueReporter")
  assignedIssues Issue[]           @relation("IssueAssignee")
  comments       Comment[]
  attachments    Attachment[]
  notifications  Notification[]
  activities     IssueActivity[]
  AutomationRule AutomationRule[]
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  // Relations
  members  WorkspaceMember[]
  projects Project[]
}

model WorkspaceMember {
  id   String @id @default(uuid())
  role Role   @default(MEMBER)

  // Relations
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

model Project {
  id              String @id @default(uuid())
  name            String
  key             String // e.g., "ENG"
  nextIssueNumber Int    @default(1)

  // Relations
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprints        Sprint[]
  issues         Issue[]
  boards         Board[]
  milestones     Milestone[]
  labels         IssueLabel[]
  AutomationRule AutomationRule[]

  @@unique([workspaceId, key]) // Project keys must be unique within a workspace
  @@index([workspaceId])
}

model Sprint {
  id        String       @id @default(uuid())
  name      String
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNED)

  // Relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@index([projectId])
}

model Issue {
  id          String   @id @default(uuid())
  key         String // e.g., "ENG-123"
  title       String
  description String?
  priority    Priority @default(MEDIUM)
  type        ItemType @default(TASK)
  points      Int?
  rank        Int // For drag-and-drop ordering
  version     Int      @default(1) // Optimistic concurrency control

  startDate DateTime?
  dueDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId  String?
  sprint    Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  boardId String?
  board   Board?  @relation(fields: [boardId], references: [id], onDelete: SetNull)

  statusId String?
  status   BoardColumn? @relation(fields: [statusId], references: [id], onDelete: SetNull)

  reporterId String
  reporter   User    @relation("IssueReporter", fields: [reporterId], references: [id])
  assigneeId String?
  assignee   User?   @relation("IssueAssignee", fields: [assigneeId], references: [id])

  comments      Comment[]
  attachments   Attachment[]
  activities    IssueActivity[]
  notifications Notification[]

  parentIssueId String?
  parentIssue   Issue?  @relation("IssueSubtasks", fields: [parentIssueId], references: [id])
  subtasks      Issue[] @relation("IssueSubtasks")

  epicId     String?
  epic       Issue?  @relation("IssueEpic", fields: [epicId], references: [id])
  epicIssues Issue[] @relation("IssueEpic")

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  blockedBy IssueDependency[] @relation("BlockedBy")
  blocking  IssueDependency[] @relation("Blocking")

  labels IssueLabel[]

  @@unique([projectId, key])
  @@index([projectId])
  @@index([boardId])
  @@index([sprintId])
  @@index([statusId])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([parentIssueId])
  @@index([epicId])
  @@index([milestoneId])
}

model IssueLabel {
  id        String   @id @default(uuid())
  name      String
  color     String?
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  issues Issue[]

  @@unique([projectId, name])
  @@index([projectId])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relations
  issueId  String
  issue    Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([authorId])
}

model AutomationRule {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  // Trigger (e.g. ISSUE_CREATED, STATUS_CHANGED)
  triggerType   String
  // JSON config for trigger conditions (e.g. { "statusId": "123" })
  triggerConfig Json?

  // Action (e.g. ASSIGN_USER, SEND_EMAIL)
  actionType   String
  // JSON config for action (e.g. { "userId": "abc" })
  actionConfig Json?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Attachment {
  id        String   @id @default(uuid())
  filename  String
  url       String
  mimetype  String
  size      Int
  createdAt DateTime @default(now())

  // Relations
  issueId    String
  issue      Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([uploaderId])
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  issueId String?
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([issueId])
}

model Board {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  columns BoardColumn[]
  issues  Issue[]

  @@index([projectId])
}

model BoardColumn {
  id        String   @id @default(uuid())
  title     String
  rank      Int
  createdAt DateTime @default(now())

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  issues Issue[]

  @@index([boardId])
}

model Milestone {
  id          String    @id @default(uuid())
  title       String
  description String?
  startDate   DateTime?
  dueDate     DateTime?
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())

  // Relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@index([projectId])
}

model IssueDependency {
  id   String         @id @default(uuid())
  type DependencyType @default(BLOCKS)

  blockedIssueId String
  blockedIssue   Issue  @relation("BlockedBy", fields: [blockedIssueId], references: [id], onDelete: Cascade)

  blockingIssueId String
  blockingIssue   Issue  @relation("Blocking", fields: [blockingIssueId], references: [id], onDelete: Cascade)

  @@unique([blockedIssueId, blockingIssueId])
  @@index([blockedIssueId])
  @@index([blockingIssueId])
}

// Enums
enum NotificationType {
  ASSIGNED
  MENTIONED
  COMMENTED
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ItemType {
  TASK
  BUG
  STORY
  EPIC
  SUB_TASK
}

enum DependencyType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

model IssueActivity {
  id        String       @id @default(uuid())
  type      ActivityType
  oldValue  String?
  newValue  String?
  createdAt DateTime     @default(now())

  // Relations
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([userId])
}

enum ActivityType {
  STATUS_CHANGE
  ASSIGNEE_CHANGE
  PRIORITY_CHANGE
  SPRINT_CHANGE
  TITLE_CHANGE
  DESCRIPTION_CHANGE
  POINTS_CHANGE
}
